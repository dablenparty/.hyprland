# Modified from: https://aur.archlinux.org/cgit/aur.git/tree/PKGBUILD?h=xdg-desktop-portal-hyprland-git

_pkgname="xdg-desktop-portal-hyprland"
pkgname="$_pkgname-git"
pkgver=1.4.1.r7.ge87ae78
pkgrel=1
pkgdesc="xdg-desktop-portal backend for Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/hyprwm/xdg-desktop-portal-hyprland"
license=('BSD-3-Clause')

depends=(
  hyprlang-git
  hyprutils-git
  libdrm
  libinih
  libpipewire
  mesa
  qt6-base
  qt6-wayland
  sdbus-cpp
  wayland
  xdg-desktop-portal
)
makedepends=(
  abseil-cpp
  cmake
  git
  hyprland-protocols-git
  hyprwayland-scanner-git
  ninja
  wayland-protocols
)
optdepends=(
  'grim: required for the screenshot portal to function'
  'slurp: support for interactive mode for the screenshot portal; one of the built-in chooser options for the screencast portal'
  'hyprland: the Hyprland compositor'
)

provides=("$_pkgname=${pkgver%%.r*}" "xdg-desktop-portal-impl")
conflicts=("$_pkgname")

source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname" || exit

  printf "%s" "${ git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'; }"
}

prepare() {
  cd "$srcdir/$_pkgname" || exit

  local cmake_options=(
    -B build
    -S .
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_INSTALL_LIBEXECDIR=lib
  )
  cmake "${cmake_options[@]}"
}

build() {
  cd "$srcdir/$_pkgname" || exit

  cmake --build build
}

package() {
  cd "$srcdir/$_pkgname" || exit

  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
